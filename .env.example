# Local Compose defaults. Replace secrets before use; production Compose enforces secure cookies and Redis.
POSTGRES_DB=securityops
POSTGRES_USER=securityops
POSTGRES_PASSWORD=change-this-local-password-before-starting
# Generate a Fernet key before enabling MFA; keep the same key on every API instance.
MFA_ENCRYPTION_KEY=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Use the deployed HTTPS origin when browsers access a different origin.
CORS_ORIGINS=http://localhost:5173
# Ensure this subnet does not overlap another Docker or host network.
APP_NETWORK_SUBNET=172.28.0.0/24
APP_FRONTEND_IP=172.28.0.10
# Comma-separated addresses of trusted proxies; never use "*".
FORWARDED_ALLOW_IPS=172.28.0.10
# Private, not web-served document storage. Set to a persistent directory outside public static files.
DOCUMENT_STORAGE_PATH=/var/lib/securityops/documents
# Upload limit (20 MiB by default; maximum supported setting is 100 MiB).
DOCUMENT_MAX_UPLOAD_BYTES=20971520
