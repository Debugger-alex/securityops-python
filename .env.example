# Only for local development. Use a unique secret for every server installation.
POSTGRES_DB=securityops
POSTGRES_USER=securityops
POSTGRES_PASSWORD=change-this-local-password-before-starting
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Set to the public frontend origin when deployed behind a configured HTTPS proxy.
CORS_ORIGINS=http://localhost:5173
# Lokal ohne HTTPS auf false lassen; auf einem HTTPS-Server unbedingt true setzen.
SESSION_COOKIE_SECURE=false
# Für sensible Objektangaben einen eigenen, stabil zu sichernden 32-Byte-Schlüssel setzen.
# Erzeugen: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# OBJECT_DATA_ENCRYPTION_KEY=
